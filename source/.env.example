# Server-only. Never prefix these with VITE_. Keep secrets out of Git.
SUPABASE_URL=https://YOUR-ISOLATED-PROJECT.supabase.co
SUPABASE_SECRET_KEY=SET_ON_SERVER_ONLY
# For a project using only a legacy service_role JWT, leave SUPABASE_SECRET_KEY empty.
# SUPABASE_SERVICE_ROLE_KEY=
REQUEST_HASH_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Set to each environment's own origin, with no trailing path.
PUBLIC_ORIGIN=https://YOUR-PREVIEW.vercel.app
# Client-safe. Set only when the share target is an approved stable origin.
# Leave blank to use the current browser origin during isolated review.
VITE_SHARE_ORIGIN=
# Enable only for the approved production launch.
INDEXING_ENABLED=false
# Explicitly enable only on Vercel Preview or the isolated local server.
SAMPLE_LETTERS_ENABLED=false
# Local equivalent entry point uses an embedded real PostgreSQL database.
# npm start works without a Supabase configuration, retaining data here.
LOCAL_DATABASE_PATH=.local/postgres
PORT=4173
